# ==============================================================================
# Tiyatronot Firebase Configuration (Optional)
# If left unset or incomplete, Tiyatronot runs in interactive LocalStorage demo mode.
# To connect Firebase, run: firebase login, create/select project, and paste keys below:
# ==============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Admin credentials for running data scrapers and admin seeding
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
